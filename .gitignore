/.idea/
# Local dev-only symlink shim so `node --test` can resolve @earendil-works/*
# (see extensions/.gitignore for the same rule under extensions/).
# Not part of the app; pi loads packages from the global install.
node_modules/
.analysis-driver
# pi-dart-lsp per-workspace runtime state (compiled daemon, analysis cache, log)
**/.pi/lsp/
# Dart tool output (generated; contains absolute host paths)
.dart_tool/
